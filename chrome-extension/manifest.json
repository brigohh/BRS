{
  "manifest_version": 3,
  "name": "BRS Comment Library",
  "version": "1.0",
  "description": "Suggests comments from the BRS comment library based on GRS infraction form selections.",
  "permissions": [],
  "host_permissions": [
    "https://*.firestore.googleapis.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BRS Comment Library"
  }
}
